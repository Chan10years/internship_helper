{
  "name": "internship_helper",
  "version": "1.0.0",
  "description": "Local internship assistant for BOSS直聘 and 实习僧.",
  "main": "dist/main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "crawl": "tsx src/main.ts",
    "auto:crawl": "tsx src/auto/autoCrawl.ts",
    "web": "node --env-file-if-exists=.env --import tsx src/server/server.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:import-jobs": "node --env-file-if-exists=.env --import tsx src/db/importJobs.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx src/db/verify.ts",
    "admin": "node --env-file-if-exists=.env --import tsx src/admin/cli.ts",
    "admin:invite": "node --env-file-if-exists=.env --import tsx src/admin/cli.ts invite:create",
    "build": "tsc",
    "check": "tsc --noEmit && npm run test",
    "test": "tsx --test tests/**/*.test.ts",
    "test:postgres": "tsx src/release/requireEnvironment.ts postgres && tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "tsx src/release/requireEnvironment.ts e2e && tsx --test tests/e2e/**/*.test.ts",
    "release:check": "npm run check && npm run build && npm run db:verify && npm run test:postgres && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/pg": "^8.20.0",
    "connect-pg-simple": "10.0.0",
    "csrf-sync": "4.2.1",
    "csv-stringify": "^6.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "^8.22.0",
    "playwright": "^1.61.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
